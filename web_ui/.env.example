# ローカル実行用の環境変数サンプル
# 使い方: cp .env.example .env して編集（.env は Git / イメージに含めないこと）
#
# Cloud Run では deploy_cloudrun.sh / cloudbuild.yaml が --set-env-vars で同じ値を注入します。

# GCP プロジェクト ID
PROJECT_ID=retail-search-jp-demo-minsoo

# Vertex AI のロケーション
# 注意: gemini-3.8-flash は "global" でのみ提供されています (us-central1 では 404)
LOCATION=global

# 既定の Gemini モデル
DEFAULT_MODEL=gemini-3.8-flash

# BigQuery ロード先の既定値
DEFAULT_DATASET=retail_search
DEFAULT_TABLE=d-vais-c

# Enrichment の既定並列数
MAX_CONCURRENCY=5

# 待ち受けポート (Cloud Run では自動注入されるため未設定でよい)
PORT=8080
